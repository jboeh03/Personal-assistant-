# Copy to .env.local for local dev:  cp .env.local.example .env.local
# On Vercel, set these in Project Settings → Environment Variables instead.
# NEVER paste secret keys into chat; .env.local is gitignored.

# ─── Supabase (publishable — safe in the browser; protected by RLS) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://ugrguxqdhsjflygkndkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PMdtYA-C4HyBRth3FabnYg__s9sGaAS

# ─── LLM provider keys (SECRET — server-only, never NEXT_PUBLIC_) ─────────────
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ─── Song Cockpit (/cockpit) ─────────────────────────────────────────────────
# Replicate (music generation via minimax/music-2.6): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional: which music model to render with (defaults to minimax/music-2.6)
MUSIC_MODEL=minimax/music-2.6
# Optional model overrides for the judges / co-writer (default = ANTHROPIC_MODEL)
COCKPIT_JUDGE_MODEL=
COCKPIT_COWRITER_MODEL=

# ─── E-signatures (DocuSeal, self-hosted on Railway) ─────────────────────────
# Base URL of the DocuSeal instance + API token (Settings → API in DocuSeal).
DOCUSEAL_URL=
DOCUSEAL_API_TOKEN=
# Signer identities (kept out of the repo). Signer 1 signs first.
SIGNER1_NAME=
SIGNER1_EMAIL=
SIGNER2_NAME=
SIGNER2_EMAIL=
